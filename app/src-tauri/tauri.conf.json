{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSim",
  "identifier": "de.wsim.wirtschaftssimulation",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm -C ../ui dev",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WSim – Wirtschaftssimulation 1900–2100",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WSim",
    "shortDescription": "Wirtschaftssimulation 1900–2100",
    "longDescription": "Rundenbasierte Wirtschaftssimulation von 1900 bis 2100.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "languages": ["German"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
